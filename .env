# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=slime
POSTGRES_PASSWORD=slime_secret
POSTGRES_DB=slime_db

# ─── Redis ───────────────────────────────────────────────────────────────────
# REDIS_URL is auto-built in docker-compose; override only if using external Redis
# REDIS_URL=redis://redis:6379/0

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=slime
RABBITMQ_PASSWORD=slime_secret

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── API Gateway ─────────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production
ENVIRONMENT=development

# ─── AI Mapping Engine ───────────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Legacy Simulator ────────────────────────────────────────────────────────
# 0.0 = never fail, 1.0 = always fail  (float)
FAILURE_RATE=0.2

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
